{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AtonoRobotics/dark_factory/schema/work_order.v1.json",
  "title": "Work order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "spec_hash",
    "doctrine_hash",
    "baseline_tree_hash",
    "sku",
    "grants",
    "oracles",
    "budgets",
    "state"
  ],
  "properties": {
    "id": { "type": "string" },
    "spec_hash": { "type": "string" },
    "doctrine_hash": { "type": "string" },
    "baseline_tree_hash": { "type": "string" },
    "sku": { "const": "first" },
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "oracle_ids", "allow_run"],
        "properties": {
          "id": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "oracle_ids": { "type": "array", "items": { "type": "string" } },
          "allow_run": { "type": "boolean" }
        }
      }
    },
    "oracles": { "type": "array" },
    "budgets": {
      "type": "object",
      "required": [
        "repair_cycles",
        "wall_clock_s",
        "model_calls",
        "fetch_bytes_per_pass",
        "map_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "repair_cycles": { "type": "integer" },
        "wall_clock_s": { "type": "integer" },
        "model_calls": { "type": "integer" },
        "fetch_bytes_per_pass": { "type": "integer" },
        "map_tokens": { "type": "integer" }
      }
    },
    "state": {
      "enum": [
        "admitted",
        "producing",
        "verifying",
        "repairing",
        "shipping",
        "shipped",
        "exception",
        "killed"
      ]
    }
  }
}
